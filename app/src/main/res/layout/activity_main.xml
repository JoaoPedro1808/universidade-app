<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvBoasVindas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Olá Professor, por favor, Escolha uma opção!"
        android:textAlignment="center"
        android:textSize="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.164" />

    <Button
        android:id="@+id/btNovoAluno"
        android:layout_width="175dp"
        android:layout_height="wrap_content"
        android:text="Inserir novo aluno"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvBoasVindas"
        app:layout_constraintVertical_bias="0.082" />

    <Button
        android:id="@+id/btListarAlunos"
        android:layout_width="175dp"
        android:layout_height="wrap_content"
        android:text="Listar todos os alunos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvBoasVindas"
        app:layout_constraintVertical_bias="0.26" />

    <Button
        android:id="@+id/btBuscarALuno"
        android:layout_width="175dp"
        android:layout_height="wrap_content"
        android:text="Buscar por um aluno"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvBoasVindas"
        app:layout_constraintVertical_bias="0.462" />

    <Button
        android:id="@+id/btRemoverAluno"
        android:layout_width="175dp"
        android:layout_height="wrap_content"
        android:text="Remover um aluno"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvBoasVindas"
        app:layout_constraintVertical_bias="0.652" />

    <Button
        android:id="@+id/btAtualizarAluno"
        android:layout_width="175dp"
        android:layout_height="wrap_content"
        android:text="Atualizar os dados de um aluno"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvBoasVindas"
        app:layout_constraintVertical_bias="0.868" />

</androidx.constraintlayout.widget.ConstraintLayout>